# CONIITI local development placeholders
# Copy to .env for Docker Compose, or load the same values from the secret
# manager used by the target environment. Never reuse these placeholders.

POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_DEFAULT_DB=default_db

MONGO_USER=admin
MONGO_PASSWORD=replace-with-local-mongo-password
MONGO_DB_NAME=analytics_db

RABBITMQ_USER=user
RABBITMQ_PASS=replace-with-local-rabbitmq-password
RABBITMQ_EXCHANGE=coniiti_events
RABBITMQ_DLX=coniiti_events_dlx
NOTIFICATIONS_RABBITMQ_QUEUE=notifications_queue_v2
ANALYTICS_RABBITMQ_QUEUE=analytics_queue_v2
NOTIFICATIONS_RABBITMQ_DLQ=notifications_dead_letter
ANALYTICS_RABBITMQ_DLQ=analytics_dead_letter

JWT_SECRET_KEY=replace-with-local-jwt-secret-at-least-32-chars
INTERNAL_SERVICE_TOKEN=replace-with-local-internal-service-token
ATTENDANCE_SIGNING_KEY=replace-with-a-distinct-long-random-attendance-key
AGENDA_MEDIA_ALLOWED_HOSTS=
ASSET_REFERENCE_RECONCILER_ENABLED=true
ASSET_REFERENCE_POLL_SECONDS=15
ASSET_REFERENCE_MAX_ATTEMPTS=8
ASSET_REFERENCE_PROCESSING_LEASE_SECONDS=120
AGENDA_EVENT_OUTBOX_ENABLED=true
AGENDA_EVENT_OUTBOX_POLL_SECONDS=10
ATTENDANCE_REQUIRE_REGISTRATION=true
ASISTENCIA_CONFIRMADA_ENABLED=true
PREMIO_ADJUDICADO_ENABLED=true
GRAFANA_ADMIN_USER=coniiti-admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password
GRAFANA_PORT=3000

FRONTEND_URL=http://localhost
VITE_API_URL=/api
VITE_API_ORIGIN=http://localhost

SMTP_HOST=smtp.example.local
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=CONIITI

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/auth/oauth/google/callback

MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost/api/auth/oauth/microsoft/callback

PAYMENT_PROVIDER_MODE=mock
PUBLIC_APP_URL=http://localhost
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
MP_ACCESS_TOKEN=

FILES_MAX_IMAGE_BYTES=26214400
FILES_MAX_VIDEO_BYTES=536870912
FILES_MAX_DOCUMENT_BYTES=52428800
FILES_IMPORT_LEGACY_JSON=true
AGENDA_SERVICE_URL=http://agenda-service:8000
USERS_SERVICE_URL=http://users-service:8000
AUTH_SERVICE_URL=http://auth-service:8000
